
# 의료진 전용 로그인. 기존 GOOGLE/KAKAO/NAVER_CLIENT_ID, CLIENT_SECRET을 재사용합니다.
DOCTOR_FRONTEND_URL=http://localhost:3001
DOCTOR_GOOGLE_REDIRECT_URI=http://localhost:10000/doctors/auth/google/callback
DOCTOR_KAKAO_REDIRECT_URI=http://localhost:10000/doctors/auth/kakao/callback
DOCTOR_NAVER_REDIRECT_URI=http://localhost:10000/doctors/auth/naver/callback
# HTTPS 배포에서는 true. 로컬 HTTP 개발에서는 false.
DOCTOR_COOKIE_SECURE=false
# 추가 프론트 주소가 있으면 쉼표로 구분합니다.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
